{
  // Cloudflare Workers + Static Assets (SPA) — بدون کلید مخفی
  // استقرار: npm run build && npx wrangler deploy
  "name": "bainri-apshn-koi-2",
  "compatibility_date": "2026-11-01",
  "main": "deploy/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
